# Copy this file to .env and fill in real values locally.
# Never commit .env or real credentials.

# --- AI + search ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
TAVILY_API_KEY=your_tavily_api_key

# --- Optional email digest + account emails (Gmail app password) ---
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_gmail_app_password
RECEIVER_EMAIL=your_email@gmail.com

# --- Application ---
APP_ENV=development
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local SQLite file. Relative paths are resolved from the project root.
OPPORTUNITY_DB_PATH=data/opportunity_agent.db
# Optional PostgreSQL connection string. When set, it overrides SQLite.
DATABASE_URL=
# Serve frontend/dist from FastAPI (used by the Docker image).
SERVE_FRONTEND=0
# Public URL used in verification/reset emails.
PUBLIC_APP_URL=http://localhost:5173

# --- Authentication ---
# 0 = local demo workspace, 1 = sign-in required for user data.
AUTH_REQUIRED=0
# Require a verified email before user data is available.
AUTH_REQUIRE_VERIFIED=1
# Expose verification/reset tokens in API responses for local testing.
# NEVER enable this in public production.
AUTH_DEV_SHOW_TOKENS=0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
AUTH_TOKEN_MINUTES=10080

# --- Curated internship datasets ---
# How long downloaded listings stay cached before re-downloading.
CURATED_CACHE_HOURS=24

# --- Abuse protection ---
RATE_LIMIT_ENABLED=1
# Trust X-Forwarded-For only behind a known reverse proxy.
TRUST_PROXY=0